<UserControl x:Class="Launcher.Views.ColorPickerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="232">
    <Border CornerRadius="12"
            Background="{DynamicResource ThemeWindowBackgroundBrush}"
            BorderBrush="{DynamicResource ThemeWindowBorderBrush}"
            BorderThickness="1"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="24" ShadowDepth="4"/>
        </Border.Effect>
        <StackPanel>
            <!-- Saturation/Value square -->
            <Grid Width="204" Height="140" ClipToBounds="True" Cursor="Cross"
                  MouseLeftButtonDown="OnSvMouseDown" MouseMove="OnSvMouseMove" MouseLeftButtonUp="OnSvMouseUp">
                <Border x:Name="SvHueLayer" CornerRadius="8"/>
                <Border CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas>
                    <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2"
                             IsHitTestVisible="False" Canvas.Left="-7" Canvas.Top="-7">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="4" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <!-- Hue slider -->
            <Grid Height="16" Margin="0,10,0,0" Cursor="Hand"
                  MouseLeftButtonDown="OnHueMouseDown" MouseMove="OnHueMouseMove" MouseLeftButtonUp="OnHueMouseUp">
                <Border CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0000" Offset="0.0"/>
                            <GradientStop Color="#FFFF00" Offset="0.1667"/>
                            <GradientStop Color="#00FF00" Offset="0.3333"/>
                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                            <GradientStop Color="#0000FF" Offset="0.6667"/>
                            <GradientStop Color="#FF00FF" Offset="0.8333"/>
                            <GradientStop Color="#FF0000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas>
                    <Border x:Name="HueThumb" Width="4" Height="16" Background="White" CornerRadius="2"
                            IsHitTestVisible="False" Canvas.Left="-2">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="3" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                </Canvas>
            </Grid>

            <!-- Hex entry + live swatch -->
            <DockPanel Margin="0,12,0,0">
                <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,8,0"
                        Background="{DynamicResource ThemeAccentBrush}" x:Name="LivePreviewSwatch"
                        BorderBrush="{DynamicResource ThemeWindowBorderBrush}" BorderThickness="1"/>
                <TextBox x:Name="HexBox" VerticalAlignment="Center" Padding="8,6" FontFamily="Consolas"
                         Background="#14FFFFFF" BorderThickness="0" Foreground="{DynamicResource ThemePrimaryTextBrush}"
                         TextChanged="OnHexBoxTextChanged"/>
            </DockPanel>

            <!-- Preset swatches -->
            <TextBlock Text="PRESETS" FontSize="10" FontWeight="SemiBold" Opacity="0.6"
                       Foreground="{DynamicResource ThemeCategoryTextBrush}" Margin="0,14,0,6"/>
            <ItemsControl x:Name="PresetsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
