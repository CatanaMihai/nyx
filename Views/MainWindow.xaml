<Window x:Class="Launcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Launcher.Models"
        xmlns:conv="clr-namespace:Launcher.Converters"
        Title="Nyx"
        Icon="/Assets/nyx.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Visibility="Hidden"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">

    <!--
        All colors/sizes below are DynamicResource lookups into
        Application.Current.Resources, populated live by ThemeService from
        the active ThemeDefinition (see /Themes). Nothing visual is
        hard-coded here so a theme change (including a live preview edit in
        the Settings window) updates this window instantly with no restart -
        ThemeService only ever touches the resource dictionary.
    -->
    <Window.Resources>
        <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter"/>
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="{DynamicResource ThemeResultMargin}"/>
            <Setter Property="MinHeight" Value="{DynamicResource ThemeResultHeight}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                CornerRadius="{DynamicResource ThemeResultCornerRadius}"
                                Background="Transparent"
                                Padding="10,8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ThemeResultHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ThemeSelectedBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Outer Grid is fully transparent and exists only to give the glow (below)
        room to blur without being clipped at the window's edge - without this
        margin, the DropShadowEffect's blur gets hard-cut at the window bounds,
        which is what produced the visible rectangular corners. GlowMargin in
        the code-behind keeps this in sync with the Window's extra Width/Height.
    -->
    <Grid Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Border x:Name="RootBorder"
                Margin="{DynamicResource ThemeGlowMargin}"
                CornerRadius="{DynamicResource ThemeWindowCornerRadius}"
                Background="{DynamicResource ThemeWindowBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeWindowBorderBrush}"
                BorderThickness="{DynamicResource ThemeWindowBorderThickness}"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect x:Name="GlowEffect"
                                   Color="{DynamicResource ThemeGlowColor}"
                                   BlurRadius="{DynamicResource ThemeGlowRadius}"
                                   ShadowDepth="0"
                                   Opacity="{DynamicResource ThemeGlowOpacity}"/>
            </Border.Effect>

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ScaleTransform" ScaleX="0.97" ScaleY="0.97"/>
                    <TranslateTransform x:Name="TranslateTransform" Y="6"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>

            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search box -->
                <Grid Grid.Row="0" Margin="{DynamicResource ThemeSearchRowMargin}" MinHeight="{DynamicResource ThemeSearchBoxHeight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Width="20" Height="20" Margin="2,0,12,0" Stretch="Uniform"
                          Fill="{DynamicResource ThemeSearchIconBrush}"
                          Data="M9.5,3 C13.09,3 16,5.91 16,9.5 C16,11.02 15.49,12.42 14.63,13.54 L20.29,19.2 C20.68,19.59 20.68,20.22 20.29,20.61 C19.9,21 19.27,21 18.88,20.61 L13.23,14.95 C12.11,15.81 10.71,16.32 9.5,16.32 C5.91,16.32 3,13.41 3,9.5 C3,5.91 5.91,3 9.5,3 Z M9.5,5 C7.01,5 5,7.01 5,9.5 C5,11.99 7.01,14 9.5,14 C11.99,14 14,11.99 14,9.5 C14,7.01 11.99,5 9.5,5 Z"/>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource ThemeSearchTextBrush}"
                             CaretBrush="{DynamicResource ThemeAccentBrush}"
                             FontFamily="{DynamicResource ThemeSearchFontFamily}"
                             FontSize="{DynamicResource ThemeSearchFontSize}"
                             FontWeight="Light"
                             VerticalAlignment="Center"
                             Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="0"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBlock Grid.Column="1"
                               Text="Search apps..."
                               FontFamily="{DynamicResource ThemeSearchFontFamily}"
                               FontSize="{DynamicResource ThemeSearchFontSize}"
                               FontWeight="Light"
                               Foreground="{DynamicResource ThemePlaceholderTextBrush}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding QueryText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{DynamicResource ThemeDividerBrush}" Margin="0"
                        Visibility="{Binding Results.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                <!-- Results -->
                <ListBox x:Name="ResultsList"
                         Grid.Row="2"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="{DynamicResource ThemeResultAreaSpacing}"
                         MaxHeight="{DynamicResource ThemeResultsMaxHeight}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding Results}"
                         SelectedIndex="{Binding SelectedIndex}"
                         ItemContainerStyle="{StaticResource ResultItemStyle}"
                         Visibility="{Binding Results.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SearchResult}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="{DynamicResource ThemeIconSize}" Height="{DynamicResource ThemeIconSize}" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="{DynamicResource ThemeIconSize}" Height="{DynamicResource ThemeIconSize}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText"
                                               Text="{Binding Title}"
                                               Foreground="{DynamicResource ThemePrimaryTextBrush}"
                                               FontFamily="{DynamicResource ThemeSearchFontFamily}"
                                               FontSize="{DynamicResource ThemeResultTitleFontSize}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeSelectedTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="{DynamicResource ThemeSecondaryTextBrush}"
                                               FontFamily="{DynamicResource ThemeSearchFontFamily}"
                                               FontSize="{DynamicResource ThemeResultSecondaryFontSize}"
                                               Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Subtitle, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>

                                <Border Grid.Column="2" VerticalAlignment="Center" Background="{DynamicResource ThemeCategoryChipBrush}" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource ThemeCategoryTextBrush}" FontSize="11"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--
                    Ambient "shimmer" overlay: a soft diagonal highlight that sweeps
                    across the bar in a loop while it's open (theme: AmbientAnimationStyle
                    = "Shimmer"). Spans every row so it can slide the full height/width;
                    IsHitTestVisible=False keeps it from intercepting clicks, and it
                    stays fully transparent (Opacity 0) unless MainWindow.xaml.cs starts
                    the loop for the active theme.
                -->
                <Border x:Name="ShimmerOverlay" Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.4">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#20FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ShimmerTransform" X="-400"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
