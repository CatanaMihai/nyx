<Window x:Class="Launcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Launcher.Views"
        Title="Nyx Settings"
        Icon="/Assets/nyx.ico"
        Width="900" Height="660"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- ============ Shared control styles (dark, theme-aware) ============ -->

        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="9" Margin="10,2" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemeResultHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemeSelectedBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeCategoryTextBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="HexBox" TargetType="TextBox">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Width" Value="92"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Sw" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="#33FFFFFF" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sw" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark slider: thin accent-colored rail + a clean round thumb -->
        <Style x:Key="ThemedSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#1AFFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate><Rectangle Fill="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Width="16" Height="16" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="4" ShadowDepth="1"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed scrollbar: thin, rounded, translucent track + accent thumb.
             No x:Key -> applies implicitly to EVERY ScrollBar in this window,
             including the ones inside ComboBox dropdown popups (Popup content
             stays in this window's logical tree for resource lookup), so the
             settings body scrollbar and every dropdown's scrollbar match. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Width="6" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" CornerRadius="3"
                                                        Background="{DynamicResource ThemeSecondaryTextBrush}" Opacity="0.35"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.55"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark combo box -->
        <Style x:Key="ThemedComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Arrow" Grid.Column="1" Text="▾" Foreground="{DynamicResource ThemeSecondaryTextBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,2,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#20FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#20FFFFFF"/>
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleY="-1" CenterY="5"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
                                <Border CornerRadius="9" Background="{DynamicResource ThemeWindowBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeWindowBorderBrush}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="18" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemeResultHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemeSelectedBackgroundBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource ThemeSecondaryTextBrush}" Background="Transparent" VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M2,6 L5,9 L11,2" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shortcut recorder box -->
        <Style x:Key="ShortcutBox" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Border CornerRadius="16"
            Background="{DynamicResource ThemeWindowBackgroundBrush}"
            BorderBrush="{DynamicResource ThemeWindowBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="28" ShadowDepth="6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar: draggable, with close button -->
            <Grid Grid.Row="0" Height="46" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="⚙" FontSize="15" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Nyx Settings" Foreground="{DynamicResource ThemePrimaryTextBrush}"
                               FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" Margin="0,0,8,0"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeSecondaryTextBrush}"
                        Click="OnCloseClicked" Cursor="Hand" FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FF5555"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <StackPanel Grid.Column="0" Margin="0,4,0,0">
                    <ListBox x:Name="SidebarList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⚙  " /><TextBlock Text="General"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="🎨  "/><TextBlock Text="Appearance"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="🔍  "/><TextBlock Text="Search"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="✨  "/><TextBlock Text="Animations"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="ℹ  "/><TextBlock Text="About"/></StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>

                <Border Grid.Column="1" Margin="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,4,26,24">
                        <StackPanel>

                            <!-- Live preview: uses the exact same resource keys/template style as MainWindow -->
                            <TextBlock Text="PREVIEW" Style="{StaticResource SectionHeader}" Margin="0,10,0,10"/>
                            <Border CornerRadius="{DynamicResource ThemeWindowCornerRadius}"
                                    Background="{DynamicResource ThemeWindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource ThemeWindowBorderBrush}"
                                    BorderThickness="{DynamicResource ThemeWindowBorderThickness}"
                                    Padding="4" Margin="0,0,0,4">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource ThemeGlowColor}"
                                                       BlurRadius="{DynamicResource ThemeGlowRadius}"
                                                       ShadowDepth="0"
                                                       Opacity="{DynamicResource ThemeGlowOpacity}"/>
                                </Border.Effect>
                                <StackPanel Margin="{DynamicResource ThemeSearchRowMargin}">
                                    <Grid MinHeight="{DynamicResource ThemeSearchBoxHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" Margin="2,0,12,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ThemeSearchIconBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Search apps..."
                                                   FontFamily="{DynamicResource ThemeSearchFontFamily}"
                                                   FontSize="{DynamicResource ThemeSearchFontSize}"
                                                   Foreground="{DynamicResource ThemePlaceholderTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource ThemeDividerBrush}" Margin="0,4,0,8"/>
                                    <ItemsControl ItemsSource="{Binding PreviewResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="PreviewRowBorder"
                                                        CornerRadius="{DynamicResource ThemeResultCornerRadius}"
                                                        Background="Transparent"
                                                        MinHeight="{DynamicResource ThemeResultHeight}"
                                                        Margin="{DynamicResource ThemeResultMargin}"
                                                        Padding="10,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="{DynamicResource ThemeIconSize}" Height="{DynamicResource ThemeIconSize}"
                                                                Background="{DynamicResource ThemeAccentBrush}" CornerRadius="6" Margin="0,0,12,0" Opacity="0.55"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                                                   FontFamily="{DynamicResource ThemeSearchFontFamily}"
                                                                   FontSize="{DynamicResource ThemeResultTitleFontSize}"
                                                                   Foreground="{DynamicResource ThemePrimaryTextBrush}"/>
                                                        <Border Grid.Column="2" Background="{DynamicResource ThemeCategoryChipBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                            <TextBlock Text="App" FontSize="11" Foreground="{DynamicResource ThemeCategoryTextBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ThemeSelectedBackgroundBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ============ GENERAL ============ -->
                            <StackPanel Visibility="{Binding IsGeneralVisible}">
                                <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}" Margin="0,18,0,10"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="Open / close launcher" Style="{StaticResource FieldLabel}"/>
                                        <Border x:Name="ToggleShortcutBox" Style="{StaticResource ShortcutBox}" HorizontalAlignment="Left" MinWidth="220"
                                                MouseLeftButtonDown="OnToggleShortcutBoxClicked"
                                                GotFocus="OnToggleShortcutBoxFocused"
                                                Focusable="True">
                                            <TextBlock x:Name="ToggleShortcutText" Text="{Binding GlobalShortcut}"
                                                       Foreground="{DynamicResource ThemePrimaryTextBrush}" FontFamily="Consolas" FontSize="13"/>
                                        </Border>
                                        <TextBlock Text="Click, then press a key combination to change it. Takes effect immediately."
                                                   Style="{StaticResource FieldLabel}" Margin="0,8,0,0" Opacity="0.65" TextWrapping="Wrap"/>

                                        <TextBlock Text="Open settings" Style="{StaticResource FieldLabel}" Margin="0,18,0,5"/>
                                        <Border x:Name="SettingsShortcutBox" Style="{StaticResource ShortcutBox}" HorizontalAlignment="Left" MinWidth="220"
                                                MouseLeftButtonDown="OnSettingsShortcutBoxClicked"
                                                GotFocus="OnSettingsShortcutBoxFocused"
                                                Focusable="True">
                                            <TextBlock x:Name="SettingsShortcutText" Text="{Binding SettingsShortcutDisplay}"
                                                       Foreground="{DynamicResource ThemePrimaryTextBrush}" FontFamily="Consolas" FontSize="13"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============ APPEARANCE ============ -->
                            <StackPanel Visibility="{Binding IsAppearanceVisible}">
                                <TextBlock Text="THEME" Style="{StaticResource SectionHeader}" Margin="0,18,0,10"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <ComboBox Width="240" HorizontalAlignment="Left" Style="{StaticResource ThemedComboBox}"
                                              ItemsSource="{Binding AvailableThemes}"
                                              SelectedItem="{Binding SelectedThemeName}"/>
                                </Border>

                                <TextBlock Text="COLORS" Style="{StaticResource SectionHeader}"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <UniformGrid Columns="2" Rows="3">
                                        <StackPanel Margin="0,0,12,14">
                                            <TextBlock Text="Accent" Style="{StaticResource FieldLabel}"/>
                                            <DockPanel>
                                                <Button Style="{StaticResource SwatchButton}" Background="{Binding AccentColorSwatch}"
                                                        Tag="AccentColor" Click="OnSwatchClick"/>
                                                <TextBox Style="{StaticResource HexBox}" Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="Background" Style="{StaticResource FieldLabel}"/>
                                            <DockPanel>
                                                <Button Style="{StaticResource SwatchButton}" Background="{Binding BackgroundColorSwatch}"
                                                        Tag="BackgroundColor" Click="OnSwatchClick"/>
                                                <TextBox Style="{StaticResource HexBox}" Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,14">
                                            <TextBlock Text="Text" Style="{StaticResource FieldLabel}"/>
                                            <DockPanel>
                                                <Button Style="{StaticResource SwatchButton}" Background="{Binding PrimaryTextColorSwatch}"
                                                        Tag="PrimaryTextColor" Click="OnSwatchClick"/>
                                                <TextBox Style="{StaticResource HexBox}" Text="{Binding PrimaryTextColor, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="Selected result" Style="{StaticResource FieldLabel}"/>
                                            <DockPanel>
                                                <Button Style="{StaticResource SwatchButton}" Background="{Binding SelectedBackgroundColorSwatch}"
                                                        Tag="SelectedBackgroundColor" Click="OnSwatchClick"/>
                                                <TextBox Style="{StaticResource HexBox}" Text="{Binding SelectedBackgroundColor, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Border" Style="{StaticResource FieldLabel}"/>
                                            <DockPanel>
                                                <Button Style="{StaticResource SwatchButton}" Background="{Binding BorderColorSwatch}"
                                                        Tag="BorderColor" Click="OnSwatchClick"/>
                                                <TextBox Style="{StaticResource HexBox}" Text="{Binding BorderColor, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,0">
                                            <TextBlock Text="Glow color" Style="{StaticResource FieldLabel}"/>
                                            <DockPanel>
                                                <Button Style="{StaticResource SwatchButton}" Background="{Binding GlowColorSwatch}"
                                                        Tag="GlowColor" Click="OnSwatchClick"/>
                                                <TextBox Style="{StaticResource HexBox}" Text="{Binding GlowColor, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>

                                <TextBlock Text="WINDOW" Style="{StaticResource SectionHeader}"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding BackgroundOpacityPercent, StringFormat='Opacity  {0:0}%'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="30" Maximum="100" Value="{Binding BackgroundOpacityPercent}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="{Binding CornerRadius, StringFormat='Corner radius  {0:0}'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="0" Maximum="40" Value="{Binding CornerRadius}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="{Binding WindowWidth, StringFormat='Width  {0:0}'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="480" Maximum="900" Value="{Binding WindowWidth}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="{Binding BorderThickness, StringFormat='Border thickness  {0:0.#}'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="0" Maximum="4" Value="{Binding BorderThickness}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="GLOW" Style="{StaticResource SectionHeader}"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <CheckBox Content="Enable glow" Style="{StaticResource ThemedCheckBox}" IsChecked="{Binding GlowEnabled}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4" Text="{Binding GlowIntensityPercent, StringFormat='Glow intensity  {0:0}%'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="0" Maximum="100" Value="{Binding GlowIntensityPercent}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="{Binding GlowRadius, StringFormat='Glow radius  {0:0}'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="0" Maximum="60" Value="{Binding GlowRadius}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="RESULTS" Style="{StaticResource SectionHeader}"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding ResultHeight, StringFormat='Result height  {0:0}'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="36" Maximum="90" Value="{Binding ResultHeight}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="{Binding IconSize, StringFormat='Icon size  {0:0}'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="16" Maximum="48" Value="{Binding IconSize}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="{Binding ResultSpacing, StringFormat='Spacing  {0:0}'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="0" Maximum="16" Value="{Binding ResultSpacing}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============ SEARCH ============ -->
                            <StackPanel Visibility="{Binding IsSearchVisible}">
                                <TextBlock Text="SEARCH" Style="{StaticResource SectionHeader}" Margin="0,18,0,10"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding MaxResultCount, StringFormat='Max results  {0}'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="3" Maximum="20" Value="{Binding MaxResultCount}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="FONT" Style="{StaticResource SectionHeader}"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="Font family" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Width="260" HorizontalAlignment="Left" Style="{StaticResource ThemedComboBox}"
                                                  ItemsSource="{Binding AvailableFontFamilies}"
                                                  SelectedItem="{Binding SearchFontFamily}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4" Text="{Binding SearchFontSize, StringFormat='Search box font size  {0:0}'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="14" Maximum="32" Value="{Binding SearchFontSize}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="{Binding ResultTitleFontSize, StringFormat='Result title font size  {0:0}'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="11" Maximum="22" Value="{Binding ResultTitleFontSize}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="{Binding ResultSecondaryFontSize, StringFormat='Result secondary font size  {0:0}'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="9" Maximum="18" Value="{Binding ResultSecondaryFontSize}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============ ANIMATIONS ============ -->
                            <StackPanel Visibility="{Binding IsAnimationsVisible}">
                                <TextBlock Text="OPEN / CLOSE" Style="{StaticResource SectionHeader}" Margin="0,18,0,10"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <CheckBox Content="Enable animations" Style="{StaticResource ThemedCheckBox}" IsChecked="{Binding AnimationsEnabled}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4" Text="{Binding OpenDurationMs, StringFormat='Open/close duration  {0}ms'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="60" Maximum="400" Value="{Binding OpenDurationMs}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="AMBIENT (WHILE OPEN)" Style="{StaticResource SectionHeader}"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="Pattern" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Width="200" HorizontalAlignment="Left" Style="{StaticResource ThemedComboBox}"
                                                  ItemsSource="{Binding AvailableAmbientStyles}"
                                                  SelectedItem="{Binding AmbientAnimationStyle}"/>
                                        <TextBlock Text="A looping effect played inside the bar while it's open — a slow glow &quot;breathing&quot; pulse, a soft light sweep, or irregular signal-glitch bursts. Off by default to stay minimal."
                                                   Style="{StaticResource FieldLabel}" Margin="0,8,0,0" Opacity="0.65" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4" Text="{Binding AmbientAnimationSpeedSeconds, StringFormat='Cycle speed  {0:0.0}s'}"/>
                                        <Slider Style="{StaticResource ThemedSlider}" Minimum="1" Maximum="8" Value="{Binding AmbientAnimationSpeedSeconds}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============ ABOUT ============ -->
                            <StackPanel Visibility="{Binding IsAboutVisible}">
                                <TextBlock Text="ABOUT" Style="{StaticResource SectionHeader}" Margin="0,18,0,10"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="Nyx" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="A fast, keyboard-first application launcher for Windows." Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                        <TextBlock Text="Settings: %AppData%\Launcher\settings.json" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" Opacity="0.7"/>
                                        <TextBlock Text="Themes: %AppData%\Launcher\Themes\" Style="{StaticResource FieldLabel}" Opacity="0.7"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!--
                Persistent footer: Reset/Save apply to the WHOLE theme (every tab,
                not just Appearance) and stay visible no matter which sidebar section
                is selected. Closing Settings without pressing Save discards ANY
                unsaved edits from ANY tab — Animations included — so Save needs to
                be reachable from every tab, not tucked away inside just one of them.
            -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#0DFFFFFF" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ThemeDividerBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,26,12">
                    <TextBlock x:Name="SaveStatusText" Text="" Foreground="{DynamicResource ThemeSecondaryTextBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" Opacity="0.75"/>
                    <Button Content="Reset to Midnight Cyan" Style="{StaticResource FlatButton}" Margin="0,0,10,0" Click="OnResetClicked"
                            Background="#14FFFFFF" Foreground="{DynamicResource ThemePrimaryTextBrush}"/>
                    <Button Content="Save changes" Style="{StaticResource FlatButton}"
                            Background="{DynamicResource ThemeAccentBrush}" Foreground="#0A0A0A"
                            Click="OnSaveClicked"/>
                </StackPanel>
            </Grid>

            <!-- Shared color-picker popup: repositioned + retargeted per swatch click -->
            <Popup x:Name="ColorPopup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False" PopupAnimation="Fade">
                <local:ColorPickerPopup x:Name="ColorPicker" SelectedColorHex="{Binding ActiveColorHex, Mode=TwoWay}"/>
            </Popup>
        </Grid>
    </Border>
</Window>
